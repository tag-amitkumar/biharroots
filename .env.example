# Copy to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------
# DATABASE_URL is the POOLED connection string the app uses at runtime. Every
# serverless invocation opens its own connection, so an unpooled URL exhausts
# the database's connection limit under load - use the pgbouncer/pooler
# endpoint your provider gives you (Neon: the "-pooler" host; Vercel Postgres:
# POSTGRES_PRISMA_URL; Supabase: port 6543).
DATABASE_URL="postgresql://user:password@host:5432/naturecart?sslmode=require"

# DIRECT_URL is the UNPOOLED connection, used only by `prisma migrate`.
# Migrations take advisory locks that a transaction pooler silently drops, so
# they must bypass the pooler. (Neon: the plain host; Vercel Postgres:
# POSTGRES_URL_NON_POOLING; Supabase: port 5432.)
DIRECT_URL="postgresql://user:password@host:5432/naturecart?sslmode=require"

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Must be the full public origin of the deployment, no trailing slash.
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional - "Continue with Google" on /login is hidden
# entirely until both are set). Create credentials at
# https://console.cloud.google.com/apis/credentials with an authorized
# redirect URI of {NEXTAUTH_URL}/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Site metadata
# ---------------------------------------------------------------------------
# Public site URL used for metadata/Open Graph/sitemap - set to the real
# production domain in deployment. Falls back to NEXTAUTH_URL, then to Vercel's
# per-deployment VERCEL_URL - leave this unset on Preview environments so each
# preview's metadata/sitemap point at that deployment rather than production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cloudinary (product image uploads)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# AI features (all optional)
# ---------------------------------------------------------------------------
# The first configured key wins, checked in this order: OpenAI, Anthropic,
# Gemini. With none set, the AI endpoints report themselves as unconfigured
# and the UI falls back to its non-AI behaviour.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
